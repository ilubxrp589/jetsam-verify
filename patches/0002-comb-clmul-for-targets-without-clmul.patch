+    /// Carry-less 64x64 -> 128 multiply, 4-bit comb (Lopez-Dahab).
+    ///
+    /// Reached on every target that has no carry-less multiply instruction.
+    /// wasm32 has none, not even in SIMD128, so browser verification pays this
+    /// on every GF(2^128) multiply, which dominates the structural scan.
+    ///
+    /// The bit-serial predecessor ran once per set bit of `b` (~32 on average)
+    /// and did a full 128-bit multiply each time; on wasm32 that multiply is
+    /// itself synthesised out of 64-bit halves. This version precomputes
+    /// `a * u` for every 4-bit `u`, then folds `b` one nibble at a time with
+    /// Horner's rule, so every shift is by a compile-time constant and no
+    /// 128-bit multiply is emitted at all.
     #[inline(always)]
     pub fn clmul_64x64(a: u64, b: u64) -> u128 {
-        let mut res = 0u128;
-        let mut b = b as u128;
         let a = a as u128;
-        while b != 0 {
-            let lsb = b & (!b + 1);
-            res ^= a * lsb;
-            b ^= lsb;
+
+        // t[u] = a * u over GF(2)[x], for u in 0..16. Multiplying by x is a
+        // shift, so a*(2u) = (a*u) << 1 and a*(2u+1) = a*(2u) ^ a.
+        let mut t = [0u128; 16];
+        t[1] = a;
+        let mut u = 2usize;
+        while u < 16 {
+            t[u] = t[u >> 1] << 1;
+            t[u + 1] = t[u] ^ a;
+            u += 2;
+        }
+
+        // Horner over the 16 nibbles of `b`, most significant first. The
+        // running value tops out at 127 bits, so `res << 4` cannot overflow.
+        let mut res = 0u128;
+        let mut rest = b;
+        let mut i = 0;
+        while i < 16 {
+            let nibble = (rest >> 60) as usize; // < 16 by construction
+            res = (res << 4) ^ t[nibble];
+            rest <<= 4;
+            i += 1;
         }
         res
     }
