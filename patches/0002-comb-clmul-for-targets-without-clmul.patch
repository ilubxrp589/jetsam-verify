+#[cfg(test)]
+mod soft_clmul_tests {
+    use super::*;
+
+    /// xorshift64. Deterministic, so a failure is reproducible from the seed.
+    fn stream(seed: u64) -> impl FnMut() -> u64 {
+        let mut s = seed;
+        move || {
+            s ^= s << 13;
+            s ^= s >> 7;
+            s ^= s << 17;
+            s
+        }
+    }
+
+    /// The definition of carry-less multiplication, one bit at a time.
+    fn clmul_reference(a: u64, b: u64) -> u128 {
+        let mut res = 0u128;
+        for i in 0..64 {
+            if (b >> i) & 1 == 1 {
+                res ^= (a as u128) << i;
+            }
+        }
+        res
+    }
+
+    #[test]
+    fn comb_matches_bitwise_reference() {
+        for &(a, b) in &[
+            (0u64, 0u64),
+            (0, u64::MAX),
+            (u64::MAX, 0),
+            (u64::MAX, u64::MAX),
+            (1, 1),
+            (1, u64::MAX),
+            (u64::MAX, 1),
+            (1 << 63, 1 << 63),
+        ] {
+            assert_eq!(
+                soft_clmul::clmul_64x64(a, b),
+                clmul_reference(a, b),
+                "edge case a={a:#x} b={b:#x}"
+            );
+        }
+
+        let mut next = stream(0x243f_6a88_85a3_08d3);
+        for _ in 0..50_000 {
+            let (a, b) = (next(), next());
+            assert_eq!(
+                soft_clmul::clmul_64x64(a, b),
+                clmul_reference(a, b),
+                "random a={a:#x} b={b:#x}"
+            );
+        }
+    }
+
+    /// The whole point: the software path must be indistinguishable from the
+    /// PCLMULQDQ/PMULL path, because a browser runs the software one against
+    /// digests produced by the hardware one.
+    #[test]
+    fn soft_block128_matches_hardware_path() {
+        let mut next = stream(0x9e37_79b9_7f4a_7c15);
+        let mut wide = move || ((next() as u128) << 64) | next() as u128;
+        for _ in 0..50_000 {
+            let (a, b) = (wide(), wide());
+            assert_eq!(
+                soft_clmul::clmul_block128(a, b),
+                clmul_gcm(a, b),
+                "a={a:#x} b={b:#x}"
+            );
+        }
+    }
+}
