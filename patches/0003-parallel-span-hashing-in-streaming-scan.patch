 /// digests are negligible against the span payloads.
 const DIGEST_SPAN_ROWS: usize = 2048;
 
+/// Bound on buffered span payloads before a parallel hashing flush. Keeps peak
+/// memory independent of matrix size while leaving enough spans in flight to
+/// saturate a many-core machine.
+const SPAN_BATCH_BYTES: usize = 16 << 20;
+
+/// Hash a batch of span payloads in parallel and absorb the digests in order.
+///
+/// The streaming decode is inherently sequential: spans are variable length and
+/// carry the `previous_first` delta chain and the monotone dictionary-index rule
+/// across their boundaries. The Poseidon2b hashing of a span, however, depends
+/// only on that span's own bytes, which is exactly what the two-level digest
+/// construction was designed for. The resident path already exploits this in
+/// [`matrix_span_digests`]; this does the same for the streaming verifier that
+/// third parties (browsers, light clients) actually use.
+///
+/// Ordering is preserved: `par_iter().collect()` is an indexed parallel
+/// iterator, so the digests are absorbed in span order and the statement digest
+/// is bit-identical to the sequential construction.
+fn flush_span_batch(batch: &mut Vec<(u64, Vec<u8>)>, top: &mut StreamingOnePieceByteHash) {
+    use rayon::prelude::*;
+    if batch.is_empty() {
+        return;
+    }
+    let digests: Vec<[u8; 32]> = batch
+        .par_iter()
+        .map(|(payload_len, payload)| {
+            let mut span =
+                StreamingOnePieceByteHash::new(b"JTM/IVC/FIELD-R1CS-SPAN", *payload_len);
+            span.update(payload);
+            span.finalize()
+        })
+        .collect();
+    for digest in digests {
+        top.update(&digest);
+    }
+    batch.clear();
+}
