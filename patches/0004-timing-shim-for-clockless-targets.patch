diff --git a/jetsam_fri_binius/src/timing.rs b/jetsam_fri_binius/src/timing.rs
new file mode 100644
index 0000000..918fc25
--- /dev/null
+++ b/jetsam_fri_binius/src/timing.rs
@@ -0,0 +1,33 @@
+//! Monotonic clock for instrumentation.
+//!
+//! `wasm32-unknown-unknown` has no clock: `std::time::Instant::now()` panics
+//! inside `std::sys::time::unsupported`, which aborts the verifier. Every use
+//! of `Instant` in this crate is instrumentation whose output is gated behind
+//! an environment variable, so on wasm we substitute a zero-sized stub that
+//! reports zero durations instead of killing the process.
+//!
+//! On every other target this is exactly `std::time::Instant`.
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) use std::time::Instant;
+
+#[cfg(target_arch = "wasm32")]
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Instant;
+
+#[cfg(target_arch = "wasm32")]
+impl Instant {
+    #[inline]
+    pub(crate) fn now() -> Self {
+        Self
+    }
+
+    #[inline]
+    pub(crate) fn elapsed(&self) -> core::time::Duration {
+        core::time::Duration::ZERO
+    }
+
+    #[inline]
+    pub(crate) fn duration_since(&self, _earlier: Self) -> core::time::Duration {
+        core::time::Duration::ZERO
+    }
+}
